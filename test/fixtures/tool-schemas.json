  {
    "name": "reply_email",
    "description": "Replies to an email in its conversation. The reply goes to the sender and to everyone in To and Cc of that email, except the mailbox owner, unless exclude names someone to leave out. to, cc and bcc only add people the email did not go to.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "ID of the email being replied to, as search_emails and read_email give it"
        },
        "body": {
          "type": "string",
          "description": "Reply body content (used for text/plain or when htmlBody not provided)"
        },
        "htmlBody": {
          "type": "string",
          "description": "HTML version of the reply body"
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/html",
            "multipart/alternative"
          ],
          "default": "text/plain",
          "description": "Email content type"
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Email addresses to add in To, of people the email did not go to"
        },
        "cc": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Email addresses to add in Cc, of people the email did not go to"
        },
        "bcc": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Email addresses to add in Bcc"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Email addresses of people on the email to leave out of the reply; only when the person asked to leave them out"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of file paths to attach to the reply"
        }
      },
      "required": [
        "messageId",
        "body"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "list_drafts",
    "description": "Lists the drafts in the mailbox with each draft's ID, subject, recipients (To) and date. delete_draft takes the ID shown here. maxResults is how many drafts to return: 20 when not given, at most 100.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "maxResults": {
          "type": "number",
          "description": "Maximum number of drafts to return (default 20, at most 100)"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "delete_draft",
    "description": "Permanently deletes a draft, given the draft ID that draft_email or list_drafts answers. The draft does not go to Trash and cannot be recovered. Use this, not delete_email, to remove a draft.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "draftId": {
          "type": "string",
          "description": "ID of the draft to delete, as draft_email or list_drafts give it (not the ID of its message)"
        }
      },
      "required": [
        "draftId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "get_draft",
    "description": "Reads one draft, given the draft ID that draft_email or list_drafts answers, and answers its ID, subject, recipients (To) and date, as list_drafts does for each. Use it to tell which draft an ID names before delete_draft removes it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "draftId": {
          "type": "string",
          "description": "ID of the draft to read, as draft_email or list_drafts give it (not the ID of its message)"
        }
      },
      "required": [
        "draftId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "update_draft",
    "description": "Replaces the content of an existing draft, given the draft ID that draft_email or list_drafts answers, so a corrected mail stays one draft instead of a new one. Give the whole mail again (to, subject, body, htmlBody and the rest, as draft_email takes them): the draft becomes exactly what is given. A draft that replies in a conversation stays in that conversation: its thread and the message it answers are kept unless threadId or inReplyTo are given.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "draftId": {
          "type": "string",
          "description": "ID of the draft to replace, as draft_email or list_drafts give it (not the ID of its message)"
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of recipient email addresses"
        },
        "subject": {
          "type": "string",
          "description": "Email subject"
        },
        "body": {
          "type": "string",
          "description": "Email body content (used for text/plain or when htmlBody not provided)"
        },
        "htmlBody": {
          "type": "string",
          "description": "HTML version of the email body"
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/html",
            "multipart/alternative"
          ],
          "default": "text/plain",
          "description": "Email content type"
        },
        "cc": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of CC recipients"
        },
        "bcc": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of BCC recipients"
        },
        "threadId": {
          "type": "string",
          "description": "Thread ID to reply to"
        },
        "inReplyTo": {
          "type": "string",
          "description": "Message ID being replied to"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of file paths to attach to the email"
        }
      },
      "required": [
        "draftId",
        "to",
        "subject",
        "body"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
